# ---------------------------------------------------------------------------
# Yeoun Backend — 환경 변수 템플릿
# 본 파일을 `.env`로 복사한 뒤 실제 값으로 채운다. `.env`는 git-ignored.
# Docker Compose는 같은 디렉터리의 `.env` 파일을 자동으로 읽는다.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Spring Boot 컨테이너 포트
# ---------------------------------------------------------------------------

# 호스트에서 접근할 포트.
# 예: APP_PORT=8080 이면 http://localhost:8080 으로 접근.
APP_PORT=8080

# ---------------------------------------------------------------------------
# 외부 PostgreSQL 설정
# ---------------------------------------------------------------------------

# PostgreSQL은 docker-compose에서 생성하지 않는다.
# 이미 호스팅 중인 외부 PostgreSQL JDBC URL을 입력한다.
# 형식: jdbc:postgresql://host:port/database
SPRING_DATASOURCE_URL=jdbc:postgresql://database.example.com:5432/postgres

# 외부 PostgreSQL 사용자명.
SPRING_DATASOURCE_USERNAME=postgres

# 외부 PostgreSQL 비밀번호.
SPRING_DATASOURCE_PASSWORD=change-me

# Hibernate DDL 자동 반영 전략.
# 개발/테스트: update
# 운영: validate 권장, 실제 스키마 관리는 Flyway/Liquibase 같은 migration 도구 권장.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ---------------------------------------------------------------------------
# JWT 설정
# ---------------------------------------------------------------------------

# Access Token / Refresh Token 서명에 사용할 secret key.
# 충분히 긴 랜덤 문자열을 사용한다.
# 생성 예시:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CUSTOM_JWT_SECRET_KEY=change-me-to-a-long-random-secret-key

# Access Token 만료 시간(분).
CUSTOM_JWT_ACCESS_EXP_MIN=60

# Refresh Token 만료 시간(일).
CUSTOM_JWT_REFRESH_EXP_DAY=30

# ---------------------------------------------------------------------------
# FastAPI Persona Engine 설정
# ---------------------------------------------------------------------------

# Spring Boot가 내부적으로 호출할 FastAPI Persona Engine 주소.
# FastAPI가 호스트 PC에서 실행 중이면 Docker Desktop 기준 아래 값을 사용할 수 있다.
#   http://host.docker.internal:8000/
# 외부 서버라면 예:
#   http://192.168.0.50:8000/
CUSTOM_FASTAPI_BASE_URL=http://host.docker.internal:8000/

# Spring Boot -> FastAPI 내부 호출에 사용할 Bearer 토큰.
# FastAPI 쪽 INTERNAL_TOKEN과 동일한 값이어야 한다.
# 생성 예시:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CUSTOM_FASTAPI_INTERNAL_TOKEN=change-me-to-fastapi-internal-token
